datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

enum PassType {
  DESIGN_PASS_299
  PROMOTIONAL_PASS
}

enum PassStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum CreditEventType {
  GRANT
  RESERVE
  RELEASE
  CONSUME
  EXPIRE
  ADJUSTMENT
}

enum ReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum JobStatus {
  QUEUED
  PROCESSING
  PARTIALLY_COMPLETE
  COMPLETED
  FAILED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  REFUNDED
}

enum WizardStatus {
  DRAFT
  COMPLETED
  CONFIRMED
  GENERATING
  GENERATED
  ARCHIVED
}

enum FreePreviewStatus {
  AVAILABLE
  RESERVED
  CONSUMED
  RELEASED
}

enum AssetAccessLevel {
  FREE_PREVIEW
  DESIGN_PASS
  ADMIN_ONLY
}

enum ChatMessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id               String              @id @default(uuid())
  email            String              @unique
  passwordHash     String
  name             String
  phone            String?
  role             UserRole            @default(USER)
  isEmailVerified  Boolean             @default(false)
  isPhoneVerified  Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  
  sessions         RefreshSession[]
  passes           AccessPass[]
  creditLedger     CreditTransaction[]
  reservations     CreditReservation[]
  generationJobs   GenerationJob[]
  purchases        Purchase[]
  payments         Payment[]
  leads            Lead[]
  wizardSessions   WizardSession[]
  freePreview      FreePreviewEntitlement?
  chatSessions     ChatSession[]

  @@index([email])
  @@index([phone])
}

model RefreshSession {
  id           String    @id @default(uuid())
  userId       String
  familyId     String    // For session family tracking and breach detection
  tokenHash    String    @unique
  userAgent    String
  ipAddress    String
  isRevoked    Boolean   @default(false)
  rotatedAt    DateTime? // Timestamp when rotated (for 15s grace handling)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
}

model Product {
  id             String     @id @default(uuid())
  name           String
  code           String     @unique // e.g. 'DESIGN_PASS_299'
  description    String
  priceInr       Int        // ₹299
  priceInPaise   Int        @default(29900) // 29900 paise
  currency       String     @default("INR")
  creditType     String     @default("THREE_D_GENERATION")
  creditsGranted Int        // 5 credits
  durationDays   Int        // 30 days
  autoRenewal    Boolean    @default(false)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  
  purchases      Purchase[]
}

model Purchase {
  id             String         @id @default(uuid())
  userId         String
  productId      String
  amountInr      Int
  amountInPaise  Int            @default(29900)
  currency       String         @default("INR")
  productName    String?
  durationDays   Int            @default(30)
  creditsGranted Int            @default(5)
  status         PurchaseStatus @default(PENDING)
  paymentId      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  payments       Payment[]
  passes         AccessPass[]

  @@index([userId])
  @@index([status])
}

model Payment {
  id               String        @id @default(uuid())
  purchaseId       String
  userId           String
  orderId          String        @unique
  gatewayPaymentId String?       @unique
  signature        String?
  amountInr        Int
  amountInPaise    Int           @default(29900)
  currency         String        @default("INR")
  status           PaymentStatus @default(CREATED)
  gateway          String        @default("RAZORPAY")
  rawResponse      Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  purchase         Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([status])
}

model AccessPass {
  id             String              @id @default(uuid())
  userId         String
  purchaseId     String?
  passType       PassType            @default(DESIGN_PASS_299)
  status         PassStatus          @default(ACTIVE)
  startsAt       DateTime            @default(now())
  expiresAt      DateTime
  creditsGranted Int                 @default(5)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase       Purchase?           @relation(fields: [purchaseId], references: [id])
  ledgerEntries  CreditTransaction[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

// Immutable Credit Transaction Ledger (Single Source of Truth)
model CreditTransaction {
  id            String          @id @default(uuid())
  userId        String
  passId        String?
  amount        Int             // +5 for GRANT, -1 for RESERVE, +1 for RELEASE, 0 for CONSUME
  balanceAfter  Int             @default(0)
  type          CreditEventType
  description   String
  referenceType String?         // e.g. 'PURCHASE', 'GENERATION_JOB', 'MANUAL'
  referenceId   String?         // e.g. reservationId or jobId
  idempotencyKey String?
  createdAt     DateTime        @default(now())

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pass          AccessPass?     @relation(fields: [passId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([passId])
  @@index([referenceId])
  @@index([createdAt])
}

model WizardSession {
  id                String          @id @default(uuid())
  userId            String?
  schemaVersion     Int             @default(1)
  currentStage      Int             @default(1)
  status            WizardStatus    @default(DRAFT)
  wizardData        Json
  confirmedSnapshot Json?
  inputHash         String?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  generationJobs    GenerationJob[]
  chatSessions      ChatSession[]

  @@index([userId])
  @@index([status])
  @@index([inputHash])
}

model FreePreviewEntitlement {
  id              String            @id @default(uuid())
  userId          String            @unique
  status          FreePreviewStatus @default(AVAILABLE)
  generationJobId String?           @unique
  reservedAt      DateTime?
  consumedAt      DateTime?
  releasedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationJob   GenerationJob?    @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model GenerationJob {
  id                       String                  @id @default(uuid())
  userId                   String
  projectId                String?
  wizardSessionId          String?
  accessPassId             String?
  creditReservationId      String?
  freePreviewEntitlementId String?
  jobType                  String                  // 'FREE_2D_PREVIEW', 'COMPLETE_3D_EXPERIENCE'
  generationType           String                  @default("FREE_2D_PREVIEW") // 'FREE_2D_PREVIEW', 'COMPLETE_3D_EXPERIENCE'
  status                   JobStatus               @default(QUEUED)
  attemptCount             Int                     @default(0)
  maxAttempts              Int                     @default(3)
  lockedBy                 String?
  leaseExpiresAt           DateTime?
  heartbeatAt              DateTime?
  nextRetryAt              DateTime?
  failureCode              String?
  progressStage            String?                 // 'CORE_2D', 'MODEL_3D', 'EXTERIOR_RENDERS', 'COMPLETED'
  inputPayload             Json
  resultPayload            Json?
  errorMessage             String?
  creditCost               Int                     @default(1)
  idempotencyKey           String?                 @unique
  inputHash                String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  user                     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wizardSession            WizardSession?          @relation(fields: [wizardSessionId], references: [id], onDelete: SetNull)
  assets                   GenerationAsset[]
  freePreviewEntitlement   FreePreviewEntitlement?

  @@index([userId])
  @@index([status])
  @@index([leaseExpiresAt])
}

model GenerationAsset {
  id              String           @id @default(uuid())
  generationJobId String
  assetType       String           // 'FREE_2D_PREVIEW', 'LOCKED_3D_TEASER', 'PAID_3D_EXPERIENCE', 'FLOOR_RENDER', 'EXTERIOR_RENDER', 'PDF_EXPORT', 'DOLLHOUSE_PREVIEW'
  storageKey      String
  mimeType        String
  fileSize        Int              @default(0)
  accessLevel     AssetAccessLevel @default(DESIGN_PASS)
  status          String           @default("READY")
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  generationJob   GenerationJob    @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  @@index([generationJobId])
  @@index([assetType])
  @@index([accessLevel])
}

model ConstructionRate {
  id            String    @id @default(uuid())
  city          String    @default("Indore")
  packageType   String    // 'STANDARD', 'PREMIUM', 'LUXURY'
  ratePerSqFt   Int       // e.g. 1650, 2150, 2850
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  sourceNote    String?   // 'Indicative Benchmark Rate'
  verifiedAt    DateTime?
  updatedBy     String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([city, packageType, isActive])
}

model WebhookEvent {
  id               String    @id @default(uuid())
  providerEventId  String    @unique
  eventType        String
  processingStatus String    // 'PENDING', 'PROCESSED', 'FAILED', 'IGNORED'
  payload          Json
  failureReason    String?
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?

  @@index([providerEventId])
  @@index([processingStatus])
}

model ChatSession {
  id               String        @id @default(uuid())
  userId           String?
  guestSessionHash String?
  projectId        String?
  wizardSessionId  String?
  title            String        @default("New Planning Session")
  status           String        @default("ACTIVE")
  summary          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  archivedAt       DateTime?

  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  wizardSession    WizardSession? @relation(fields: [wizardSessionId], references: [id], onDelete: SetNull)
  messages         ChatMessage[]
  usages           ChatUsage[]

  @@index([userId])
  @@index([guestSessionHash])
  @@index([wizardSessionId])
}

model ChatMessage {
  id                 String            @id @default(uuid())
  sessionId          String
  role               String            // 'user' | 'assistant' | 'system' | 'tool'
  content            String
  clientMessageId    String?
  status             ChatMessageStatus @default(COMPLETED)
  toolName           String?
  toolResult         Json?
  providerResponseId String?
  failureCode        String?
  createdAt          DateTime          @default(now())
  completedAt        DateTime?

  session            ChatSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  usages             ChatUsage[]
  feedbacks          ChatFeedback[]

  @@index([sessionId])
  @@index([clientMessageId])
  @@index([createdAt])
}

model ChatUsage {
  id            String       @id @default(uuid())
  sessionId     String
  messageId     String?
  userId        String?
  provider      String       @default("OPENAI")
  model         String       @default("gpt-4o-mini")
  inputTokens   Int          @default(0)
  outputTokens  Int          @default(0)
  estimatedCost Float        @default(0.0)
  latencyMs     Int          @default(0)
  requestId     String?
  createdAt     DateTime     @default(now())

  session       ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message       ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
}

model ChatFeedback {
  id        String      @id @default(uuid())
  messageId String
  userId    String?
  rating    Int         // 1 for helpful, -1 for unhelpful
  reason    String?
  createdAt DateTime    @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([userId])
}

model ChatQuotaUsage {
  id           String   @id @default(uuid())
  subjectId    String   // userId or guestSessionHash
  subjectType  String   // 'USER' | 'GUEST'
  usageDate    String   // YYYY-MM-DD in Asia/Kolkata
  messageCount Int      @default(0)
  tokenCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([subjectId, usageDate])
  @@index([usageDate])
}

model Lead {
  id           String     @id @default(uuid())
  userId       String?
  type         String     @default("CONSULTATION")
  name         String
  phone        String
  email        String?
  city         String     @default("Indore")
  plotSize     String?
  budgetRange  String?
  timeline     String?
  requirement  String?
  message      String?
  wizardData   Json?
  status       LeadStatus @default(NEW)
  notes        String?
  consentGiven Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([city])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  String?  // 'USER', 'ADMIN', 'SYSTEM', 'ANONYMOUS'
  action     String   // e.g. 'auth.signup', 'auth.token_reuse_detected', 'ledger.reserve'
  entityType String   // e.g. 'User', 'RefreshSession', 'CreditTransaction'
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// Atomic Credit Reservation Table (Guarantees no duplicate release/consume)
model CreditReservation {
  id           String            @id @default(uuid())
  userId       String
  jobId        String
  amount       Int               @default(1)
  status       ReservationStatus @default(RESERVED)
  settledAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
  @@index([status])
}

// Atomic Admin Setup Lock (Guarantees single initial admin setup with DB-level unique lock)
model AdminSetupLock {
  id        String    @id @default("SETUP_LOCK")
  isLocked  Boolean   @default(false)
  adminId   String?   @unique
  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
